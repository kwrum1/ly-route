*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.env text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
