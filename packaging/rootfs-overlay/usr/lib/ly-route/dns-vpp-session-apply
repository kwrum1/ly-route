#!/bin/sh
set -eu
umask 077

: "${LY_ROUTE_VPPCTL:=vppctl}"
: "${LY_ROUTE_SMARTDNS_V4_APP_PATTERN:=${LY_ROUTE_SMARTDNS_APP_PATTERN:-ly-route-dns-vpp-pro}}"
: "${LY_ROUTE_SMARTDNS_V6_APP_PATTERN:=ly-route-dns-vpp-pro}"
: "${LY_ROUTE_SMARTDNS_V4_NAMESPACE:=dns-v4}"
: "${LY_ROUTE_SMARTDNS_V6_NAMESPACE:=dns-v6}"
: "${LY_ROUTE_DNS_ENABLE_IPV6:=true}"
: "${LY_ROUTE_DNS_APP_READY_ATTEMPTS:=30}"
: "${LY_ROUTE_DNS_APP_READY_INTERVAL:=1}"

case "$LY_ROUTE_DNS_APP_READY_ATTEMPTS:$LY_ROUTE_DNS_APP_READY_INTERVAL" in
  *[!0-9:]*|0:*|*:0)
    echo "DNS application readiness retry settings must be positive integers" >&2
    exit 1
    ;;
esac

delete_tag() {
  proto=$1
  namespace=$2
  tag=$3
  tuple=$4
  show_command="show session rules $proto $tuple scope global"
  delete_command="session rule del scope global proto $proto $tuple tag $tag"
  if [ -n "$namespace" ]; then
    show_command="show session rules $proto appns $namespace $tuple scope global"
    delete_command="session rule del appns $namespace scope global proto $proto $tuple tag $tag"
  fi
  if "$LY_ROUTE_VPPCTL" "$show_command" 2>/dev/null | grep -F "tag: $tag" >/dev/null 2>&1; then
    output=$("$LY_ROUTE_VPPCTL" "$delete_command" 2>&1) || {
      printf '%s\n' "$output" >&2
      return 1
    }
    [ -z "$output" ] || {
      printf '%s\n' "$output" >&2
      return 1
    }
  fi
}

cleanup() {
  delete_tag tcp "" lyroute-smartdns-tcp4 "0.0.0.0/0 53 0.0.0.0/0 0" || true
  delete_tag udp "" lyroute-smartdns-udp4 "0.0.0.0/0 53 0.0.0.0/0 0" || true
  delete_tag tcp "$LY_ROUTE_SMARTDNS_V4_NAMESPACE" lyroute-smartdns-tcp4 "0.0.0.0/0 53 0.0.0.0/0 0" || true
  delete_tag udp "$LY_ROUTE_SMARTDNS_V4_NAMESPACE" lyroute-smartdns-udp4 "0.0.0.0/0 53 0.0.0.0/0 0" || true
  delete_tag tcp "$LY_ROUTE_SMARTDNS_V6_NAMESPACE" lyroute-smartdns-tcp6 "::/0 53 ::/0 0" || true
  delete_tag udp "$LY_ROUTE_SMARTDNS_V6_NAMESPACE" lyroute-smartdns-udp6 "::/0 53 ::/0 0" || true
}
trap cleanup INT TERM

app_indexes() {
  pattern=$1
  namespace=$2
  "$LY_ROUTE_VPPCTL" show app | awk -v pattern="$pattern" -v namespace="$namespace" '
    {
      gsub(/\r/, "", $0)
    }
    NR > 1 && ($2 ~ pattern || $0 ~ pattern) && (namespace == "" || $0 ~ (namespace "[[:space:]]*$")) { print $1 }
  '
}

resolve_app_indexes() {
  v4_indexes=$(app_indexes "$LY_ROUTE_SMARTDNS_V4_APP_PATTERN" "$LY_ROUTE_SMARTDNS_V4_NAMESPACE" 2>/dev/null || true)
  v6_indexes=""
  if [ "$LY_ROUTE_DNS_ENABLE_IPV6" = true ]; then
    v6_indexes=$(app_indexes "$LY_ROUTE_SMARTDNS_V6_APP_PATTERN" "$LY_ROUTE_SMARTDNS_V6_NAMESPACE" 2>/dev/null || true)
  fi
  v4_first=$(printf '%s\n' "$v4_indexes" | sed -n 1p)
  v6_index=$(printf '%s\n' "$v6_indexes" | tail -n 1)
  tcp4_index=${LY_ROUTE_SMARTDNS_TCP4_APP_INDEX:-$v4_first}
  udp4_index=${LY_ROUTE_SMARTDNS_UDP4_APP_INDEX:-$v4_first}
  tcp6_index=${LY_ROUTE_SMARTDNS_TCP6_APP_INDEX:-${v6_index:-0}}
  udp6_index=${LY_ROUTE_SMARTDNS_UDP6_APP_INDEX:-${v6_index:-0}}
}

app_indexes_ready() {
  case "$tcp4_index:$udp4_index" in
    ""|*:|:*|*[!0-9:]*) return 1 ;;
  esac
  if [ "$LY_ROUTE_DNS_ENABLE_IPV6" = true ]; then
    case "$tcp6_index:$udp6_index" in
      ""|*:|:*|*[!0-9:]*|0:*|*:0) return 1 ;;
    esac
  fi
  return 0
}

attempt=1
while :; do
  resolve_app_indexes
  if app_indexes_ready; then
    break
  fi
  if [ "$attempt" -ge "$LY_ROUTE_DNS_APP_READY_ATTEMPTS" ]; then
    echo "VPP DNS adapter application indexes are unavailable" >&2
    exit 1
  fi
  sleep "$LY_ROUTE_DNS_APP_READY_INTERVAL"
  attempt=$((attempt + 1))
done

cleanup
apply_rule() {
  output=$("$LY_ROUTE_VPPCTL" "$1" 2>&1) || {
    printf '%s\n' "$output" >&2
    return 1
  }
  [ -z "$output" ] || {
    printf '%s\n' "$output" >&2
    return 1
  }
}
apply_rule "session rule add appns $LY_ROUTE_SMARTDNS_V4_NAMESPACE scope global proto tcp 0.0.0.0/0 53 0.0.0.0/0 0 action $tcp4_index tag lyroute-smartdns-tcp4" || {
  cleanup
  exit 1
}
apply_rule "session rule add appns $LY_ROUTE_SMARTDNS_V4_NAMESPACE scope global proto udp 0.0.0.0/0 53 0.0.0.0/0 0 action $udp4_index tag lyroute-smartdns-udp4" || {
  cleanup
  exit 1
}
if [ "$LY_ROUTE_DNS_ENABLE_IPV6" = true ]; then
  apply_rule "session rule add appns $LY_ROUTE_SMARTDNS_V6_NAMESPACE scope global proto tcp ::/0 53 ::/0 0 action $tcp6_index tag lyroute-smartdns-tcp6" || {
    delete_tag tcp "$LY_ROUTE_SMARTDNS_V6_NAMESPACE" lyroute-smartdns-tcp6 "::/0 53 ::/0 0" || true
    exit 1
  }
  apply_rule "session rule add appns $LY_ROUTE_SMARTDNS_V6_NAMESPACE scope global proto udp ::/0 53 ::/0 0 action $udp6_index tag lyroute-smartdns-udp6" || {
    delete_tag tcp "$LY_ROUTE_SMARTDNS_V6_NAMESPACE" lyroute-smartdns-tcp6 "::/0 53 ::/0 0" || true
    delete_tag udp "$LY_ROUTE_SMARTDNS_V6_NAMESPACE" lyroute-smartdns-udp6 "::/0 53 ::/0 0" || true
    exit 1
  }
fi
trap - INT TERM
printf '%s\n' "VPP DNS adapter session rules installed (tcp4=$tcp4_index udp4=$udp4_index tcp6=$tcp6_index udp6=$udp6_index)"
