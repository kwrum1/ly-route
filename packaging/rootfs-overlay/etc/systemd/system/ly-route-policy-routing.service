[Unit]
Description=Ly Route proxy service handoff and policy routing
StartLimitIntervalSec=0
After=network-online.target vpp.service
Wants=network-online.target
Requires=vpp.service
PartOf=vpp.service
Before=smartdns.service ly-route-dns-vpp-proxy.service ly-route-dns-vpp-proxy-v6.service

[Service]
Type=oneshot
ExecStart=/usr/lib/ly-route/policy-routing-apply-default
RemainAfterExit=yes
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
