[Unit]
Description=Ly Route commercial runtime readiness check
After=network.target ly-route-firstboot.service vpp.service ly-route-vpp-session-enable.service
Wants=ly-route-firstboot.service vpp.service ly-route-vpp-session-enable.service
Requires=ly-route-vpp-session-enable.service
Before=ly-route-control-api.service ly-route-vpp-apply.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/ly-route/runtime.env
EnvironmentFile=-/etc/ly-route/control-api.env
ExecStart=/usr/lib/ly-route/runtime-check.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
