[Unit]
Description=Ly Route first boot management defaults
After=network-pre.target systemd-networkd.service
Before=network-online.target nginx.service
Before=vpp.service ly-route-runtime-check.service ly-route-vpp-apply.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/ly-route/appliance.env
ExecStart=/usr/lib/ly-route/firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
