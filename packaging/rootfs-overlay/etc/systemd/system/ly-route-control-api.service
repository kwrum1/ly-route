[Unit]
Description=Ly Route local control API
After=network.target ly-route-firstboot.service ly-route-runtime-check.service
Requires=ly-route-firstboot.service ly-route-runtime-check.service
Before=nginx.service

[Service]
Type=simple
Environment=LY_ROUTE_API_HOST=127.0.0.1
Environment=LY_ROUTE_API_PORT=8080
Environment=LY_ROUTE_CONFIG_PATH=/var/lib/ly-route/config.json
Environment=LY_ROUTE_DEFAULT_CONFIG=/etc/ly-route/default-config.json
EnvironmentFile=-/etc/ly-route/appliance.env
EnvironmentFile=-/etc/ly-route/runtime.env
EnvironmentFile=-/etc/ly-route/control-api.env
EnvironmentFile=-/var/lib/ly-route/vpp-tuning.env
ExecStart=/usr/lib/ly-route/ly-route-control
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
