#!/bin/sh
set -eu

control_binary=${LY_ROUTE_CONTROL_BINARY:?LY_ROUTE_CONTROL_BINARY is required}
vpp_socket=${LY_ROUTE_VPP_SOCKET:-/run/vpp/cli.sock}
data_dir=${LY_ROUTE_DATA_DIR:-/var/lib/ly-route}
mkdir -p /run/vpp "$data_dir" "${LY_ROUTE_DATAPLANE_STATE_DIR:-$data_dir/dataplane}"

cat >/tmp/ly-route-vpp.conf <<EOF
unix {
  nodaemon
  runtime-dir /run/vpp
  cli-listen $vpp_socket
}
api-segment {
  prefix ${LY_ROUTE_VPP_API_PREFIX:-lyroute-e2e}
}
EOF

/usr/bin/vpp -c /tmp/ly-route-vpp.conf >/tmp/ly-route-vpp.log 2>&1 &
vpp_pid=$!
cleanup() {
  [ -z "${control_pid:-}" ] || kill "$control_pid" 2>/dev/null || true
  kill "$vpp_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

attempt=0
until /usr/bin/vppctl -s "$vpp_socket" show version >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 80 ]; then
    cat /tmp/ly-route-vpp.log >&2
    exit 1
  fi
  sleep 0.1
done

# Functional container fixture. LAN uses a TAP bridged to the Docker veth so
# transmit and RA paths are bidirectional; WAN keeps AF_PACKET for PPPoE frames.
# Production still selects AF_XDP, DPDK, or another qualified native path.
for path in /sys/class/net/eth*; do
  [ -e "$path" ] || continue
  interface=${path##*/}
  [ "$interface" != "${LY_ROUTE_MANAGEMENT_INTERFACE:-eth0}" ] || continue
  vpp_interface="lyroute-$interface"
  if [ "$interface" = "${LY_ROUTE_LAN_INTERFACE:-eth1}" ]; then
    /usr/bin/vppctl -s "$vpp_socket" create tap id 101 host-if-name e2e-lan host-mtu-size 1500 no-gso >/dev/null
    /usr/bin/vppctl -s "$vpp_socket" set interface name tap101 "$vpp_interface"
    ip link add br-e2e-lan type bridge
    ip link set br-e2e-lan up
    ip link set "$interface" master br-e2e-lan
    ip link set e2e-lan master br-e2e-lan
    ip link set "$interface" up
    ip link set e2e-lan up
    /usr/bin/vppctl -s "$vpp_socket" set interface state "$vpp_interface" up
    continue
  fi
  # Docker veth acceptance uses TPACKET_V2 without virtio offloads. TPACKET_V3
  # can acknowledge TX frames without delivering them across a Docker bridge.
  /usr/bin/vppctl -s "$vpp_socket" create host-interface name "$interface" v2 cksum-gso-disable >/dev/null
  /usr/bin/vppctl -s "$vpp_socket" set interface name "host-$interface" "$vpp_interface"
  /usr/bin/vppctl -s "$vpp_socket" set interface state "$vpp_interface" up
done

"$control_binary" &
control_pid=$!
wait "$control_pid"
